# Wraith runs out of the box with bundled sample data — no env required.
# These variables only matter if you wire up the optional real-data backends.

# Database (only if you want to persist real signals/users)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wraith

# NextAuth (only if you wire up real auth — the demo uses local state)
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# OpenAI (optional — the bundled Wraith Intelligence chat is scripted by default)
OPENAI_API_KEY=

# App
APP_URL=http://localhost:3000
NODE_ENV=development
